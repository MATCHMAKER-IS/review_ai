/**
 * ① 下書き作成時に呼ぶ
 *
 * 既存の返信生成スクリプトの、draftReply 作成成功後に追記してください。
 * トリガー: チケット作成 / 更新（既存のワークフローに相乗り）
 */
// memory_version は ④ の GET /api/memory から取得した版数を渡します。
// まだ実装前なら 0 を入れておいてください。
memory_version = 0;
payload = Map();
payload.put("ticket_id",ticketId.toString());
payload.put("message",answer);
payload.put("type","ai");
payload.put("staff_id",ifnull(assigneeId,"").toString());
// 担当者名。Desk の担当者表示名を渡してください（変数名は環境に合わせて調整）。
payload.put("staff_name",ifnull(assigneeName,"").toString());
payload.put("memory",memory_version);
payload.put("prompt_id",prompt_id);
payload.put("prompt_version",prompt_version);
payload.put("model","gpt-5.6");
headers = Map();
headers.put("Content-Type","application/json");
headers.put("X-Api-Key","<HOOK_SECRET>");
resp = invokeurl
[
	url :"https://<amplify-domain>/api/review"
	type :POST
	parameters:payload.toString()
	headers:headers
];
info "下書き記録: " + resp;
