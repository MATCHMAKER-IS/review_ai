# ─── PostgreSQL ─────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/setting_ai
# Lambda 1インスタンスあたりの接続数。増やさないこと。
# 同時実行が増えるなら RDS Proxy を挟む。
PG_POOL_MAX=2

# ─── 認証 ───────────────────────────────────
# Deluge からの X-Api-Key。Secrets Manager に置くこと。
HOOK_SECRET=

# ─── OpenAI（④の分析でのみ使用）──────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ─── ④ のチューニング ────────────────────────
LEARN_MIN_REVIEWS=5
LEARN_MIN_OCCURRENCES=2
LEARN_REWRITE_RATIO=0.6
LEARN_MAX_JUDGMENT_RULES=30
LEARN_MAX_STYLE_RULES=30

# ─── 管理画面の Basic 認証 ───────────────────
# /admin/* にだけかかります。/api/review には影響しません。
# 両方設定されているときだけ認証が有効になります。
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=

# OpenAI の推論深度。差分抽出は軽いので low で十分。
# 精度を上げたいときだけ medium。none/low/medium/high/xhigh。
OPENAI_REASONING_EFFORT=low
# OpenAI 呼び出しの1回あたりタイムアウト（ミリ秒）。既定110秒。
# Lambda上限(120秒)より内側に収めています。「長く1回待つ」方針。
OPENAI_TIMEOUT_MS=110000
# タイムアウト時のリトライ回数。既定0（やり直さず1回だけ長く待つ）。
# やり直し方式にするなら、時間を短くして OPENAI_TIMEOUT_MS × (回数+1) < 120秒に。
# 例: OPENAI_TIMEOUT_MS=55000, OPENAI_MAX_RETRIES=1（55秒×2=110秒）
OPENAI_MAX_RETRIES=0
